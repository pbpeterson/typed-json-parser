{
  "name": "typed-json-parser",
  "version": "0.0.6",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
  "publishConfig": {
    "access": "public"
  },
  "author": [
    {
      "name": "Peterson Pereira Bozza",
      "email": "petersonbozza7@gmail.com"
    },
    {
      "name": "Guilherme Saliba",
      "email": "salibagui19@gmail.com"
    }
  ],
  "license": "MIT",
  "description": "A TypeScript wrapper around JSON.parse that returns {data, error} instead of throwing exceptions, following Go's error handling pattern",
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
